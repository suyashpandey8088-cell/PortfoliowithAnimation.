# ------------------------------------------------------------------
# Portfolio environment configuration
# Copy to `.env.local` for local work, and add these as Environment
# Variables in the Vercel dashboard for production.
#
# Only variables prefixed with VITE_ are exposed to the browser, so
# never put a secret here — public form endpoints only.
# ------------------------------------------------------------------

# Canonical site URL. Used for <link rel="canonical">, Open Graph tags
# and the generated sitemap. Leave blank in local development.
VITE_SITE_URL=https://your-domain.com

# Formspree form endpoint ID (the part after https://formspree.io/f/).
# When set, the contact form POSTs to Formspree for real delivery.
# When empty, the form falls back to a prefilled mailto: link instead —
# it never claims a message was sent.
VITE_FORMSPREE_ID=

# Fallback email address for the mailto: path.
# TODO(suyash): replace with your real address before deploying.
VITE_CONTACT_EMAIL=your.email@example.com
